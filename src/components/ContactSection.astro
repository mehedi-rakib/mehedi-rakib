---
import { socials } from "../data/portfolio";
import LeadForm from "./LeadForm.astro";
---

<section class="contact section" id="contact">
  <div class="shell reveal">
    <p class="eyebrow">Have a project in mind?</p>
    <h2>
      Let's build<br /><em>something great.</em>
    </h2>
    <p class="contact-note">
      I work with startups and businesses on mobile apps, e-commerce platforms,
      and AI features. Tell me about your idea.
    </p>
    <a
      class="contact-cta"
      href="mailto:mehedirakib.dev@gmail.com"
      ><span>mehedirakib.dev@gmail.com</span><b>↗</b></a
    >
  </div>

  <LeadForm />

  <footer class="footer shell">
    <p>
      © {new Date().getFullYear()} MD Mehedi Hasan Rakib · Dhaka, Bangladesh
    </p>
    <div>
      {
        socials.map((social: any) => (
          <a href={social.href} target="_blank">
            {social.label} ↗
          </a>
        ))
      }
      <a href="#top">Top ↑</a>
    </div>
  </footer>
</section>
