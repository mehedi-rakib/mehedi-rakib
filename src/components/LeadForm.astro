---
// Lead capture form component that saves to Firebase
---

<div class="lead-form-wrapper">
  <div class="lead-form-container">
    <div class="form-header">
      <h3>Let's work together</h3>
      <p>Tell me about your project. I'll get back within 24 hours.</p>
    </div>

    <form id="leadForm" class="lead-form">
      <div class="form-group">
        <input
          type="text"
          id="name"
          name="name"
          placeholder="Your name"
          required
          class="form-input"
        />
      </div>

      <div class="form-group">
        <input
          type="email"
          id="email"
          name="email"
          placeholder="your@email.com"
          required
          class="form-input"
        />
      </div>

      <div class="form-group">
        <input
          type="text"
          id="company"
          name="company"
          placeholder="Your company (optional)"
          class="form-input"
        />
      </div>

      <div class="form-group">
        <input
          type="text"
          id="projectType"
          name="projectType"
          placeholder="What are you building? (e.g., iOS app, E-commerce store)"
          required
          class="form-input"
        />
      </div>

      <div class="form-group">
        <textarea
          id="message"
          name="message"
          placeholder="Tell me more about your project..."
          rows="4"
          class="form-input"
        ></textarea>
      </div>

      <button type="submit" class="submit-btn">Send</button>
      <p class="form-note" id="formStatus"></p>
    </form>
  </div>
</div>

<style>
  .lead-form-wrapper {
    padding: clamp(40px, 6vw, 80px) 0;
    background: var(--paper);
  }

  .lead-form-container {
    width: min(92vw, 600px);
    margin: 0 auto;
    background: white;
    padding: clamp(32px, 5vw, 48px);
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(16, 17, 15, 0.08);
  }

  .form-header {
    margin-bottom: 32px;
  }

  .form-header h3 {
    font-size: clamp(24px, 4vw, 32px);
    margin: 0 0 8px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .form-header p {
    font-size: 14px;
    color: #666;
    margin: 0;
  }

  .lead-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
  }

  .form-input {
    padding: 12px 16px;
    border: 1.5px solid #ddd;
    border-radius: 8px;
    font-family: inherit;
    font-size: 14px;
    transition: border-color 0.3s, box-shadow 0.3s;
    background: white;
  }

  .form-input:focus {
    outline: none;
    border-color: var(--lime);
    box-shadow: 0 0 0 3px rgba(200, 255, 0, 0.1);
  }

  .form-input::placeholder {
    color: #999;
  }

  textarea.form-input {
    resize: vertical;
    min-height: 100px;
    font-family: inherit;
  }

  .submit-btn {
    padding: 12px 24px;
    background: var(--ink);
    color: var(--paper);
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    text-transform: uppercase;
    margin-top: 8px;
  }

  .submit-btn:hover {
    background: var(--lime);
    color: var(--ink);
    transform: translateY(-2px);
  }

  .submit-btn:active {
    transform: translateY(0);
  }

  .submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .form-note {
    font-size: 12px;
    text-align: center;
    margin: 12px 0 0;
    color: #666;
    min-height: 16px;
  }

  @media (max-width: 768px) {
    .lead-form-container {
      width: 88vw;
      padding: clamp(24px, 4vw, 32px);
    }

    .form-header h3 {
      font-size: 20px;
    }
  }
</style>

<script>
  import { db } from '../lib/firebase';
  import { collection, addDoc, Timestamp } from 'firebase/firestore';

  const form = document.getElementById('leadForm') as HTMLFormElement;
  const statusEl = document.getElementById('formStatus') as HTMLElement;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const submitBtn = form.querySelector(
        '.submit-btn'
      ) as HTMLButtonElement;
      submitBtn.disabled = true;
      statusEl.textContent = 'Sending...';

      try {
        const formData = {
          name: (document.getElementById('name') as HTMLInputElement).value,
          email: (document.getElementById('email') as HTMLInputElement).value,
          company: (document.getElementById('company') as HTMLInputElement)
            .value,
          projectType: (document.getElementById('projectType') as HTMLInputElement)
            .value,
          message: (document.getElementById('message') as HTMLTextAreaElement)
            .value,
          timestamp: Timestamp.now(),
          userAgent: navigator.userAgent,
        };

        await addDoc(collection(db, 'leads'), formData);

        statusEl.textContent = '✅ Thanks! I\'ll email you within 24 hours.';
        statusEl.style.color = '#22c55e';
        form.reset();

        setTimeout(() => {
          statusEl.textContent = '';
          submitBtn.disabled = false;
        }, 3000);
      } catch (error) {
        console.error('Error submitting form:', error);
        statusEl.textContent = '❌ Error. Please try again.';
        statusEl.style.color = '#ef4444';
        submitBtn.disabled = false;
      }
    });
  }
</script>
